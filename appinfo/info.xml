<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>folder_upload_notifications</id>
	<name>Folder Upload Notifications</name>
	<summary>Subscribe to folders and get notified about new files</summary>
	<description><![CDATA[Subscribe to individual folders and receive native Nextcloud notifications when new files are uploaded. The app is event-driven and does not scan folders in the background.]]></description>
	<version>0.4.0-alpha.1</version>
	<licence>AGPL-3.0-or-later</licence>
	<author homepage="https://github.com/AlexPuchner">AlexPuchner</author>
	<namespace>FolderUploadNotifications</namespace>
	<category>files</category>
	<website>https://github.com/AlexPuchner/nextcloud-folder-upload-notifications</website>
	<bugs>https://github.com/AlexPuchner/nextcloud-folder-upload-notifications/issues</bugs>
	<repository type="git">https://github.com/AlexPuchner/nextcloud-folder-upload-notifications.git</repository>
	<dependencies>
		<php min-version="8.1"/>
		<database>pgsql</database>
		<database>sqlite</database>
		<database>mysql</database>
		<nextcloud min-version="32" max-version="34"/>
	</dependencies>
	<settings>
		<personal>OCA\FolderUploadNotifications\Settings\Personal</personal>
		<personal-section>OCA\FolderUploadNotifications\Sections\Personal</personal-section>
	</settings>
</info>
