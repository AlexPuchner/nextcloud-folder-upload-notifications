{
	"name": "alexpuchner/nextcloud-folder-upload-notifications",
	"description": "Event-driven folder upload notifications for Nextcloud",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "AlexPuchner",
			"homepage": "https://github.com/AlexPuchner"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\FolderUploadNotifications\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\FolderUploadNotifications\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		],
		"lint": "find appinfo lib tests -name \\*.php -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1 --no-cache",
		"test:unit": "phpunit -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky"
	},
	"require": {
		"php": "^8.1"
	},
	"require-dev": {
		"bamarni/composer-bin-plugin": "^1.8",
		"nextcloud/ocp": "dev-stable32"
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.1"
		}
	}
}
